{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Parchments",
  "version": "0.1.1",
  "identifier": "com.parchments.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Parchments",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://raw.githubusercontent.com/patrickudo2004/parchments/main/updater.json"
      ],
      "pubkey": "dW51c2VkX3B1YmxpY19rZXlfdGVtcGxhdGU="
    }
  }
}